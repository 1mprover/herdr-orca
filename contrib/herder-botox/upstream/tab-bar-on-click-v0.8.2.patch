+/// Index into `tab_bar_right` of the status entry drawn at `col` of the tab
+/// row `area`, laid out exactly as `render_tab_bar` draws it.
+pub(crate) fn tab_bar_status_segment_at(app: &AppState, area: Rect, col: u16) -> Option<usize> {
+    let status_area = tab_bar_status_area(app, area)?;
+    let separator_width = display_width_u16(&app.tab_bar_right_separator);
+    let mut x = status_area.x;
+    for (position, segment) in visible_status_segments(app).iter().enumerate() {
+        if position > 0 {
+            x = x.saturating_add(separator_width);
+        }
+        let width = display_width_u16(segment.text);
+        if col >= x && col < x.saturating_add(width) {
+            return Some(segment.index);
+        }
+        x = x.saturating_add(width);
+    }
+    None
+}
